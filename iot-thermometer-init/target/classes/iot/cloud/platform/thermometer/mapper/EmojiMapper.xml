<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="iot.cloud.platform.thermometer.mapper.EmojiMapper">
    <update id="updateEmojiFace" parameterType="map">
        UPDATE emoji SET face=#{face} WHERE name=#{name} COLLATE utf8mb4_general_ci
    </update>
</mapper>